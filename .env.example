# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_DEBUG=true
BASE_URL=/BrightFuture-Educational-Website-main
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Comma-separated exact REMOTE_ADDR values of trusted reverse proxies; blank disables forwarded-proto trust.
TRUSTED_PROXIES=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brightfuture
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Optional absolute path, outside the web document root. Blank is auto-resolved by web requests.
SUBMISSION_STORAGE_PATH=
MAIL_FROM=no-reply@brightfuture.local
MAIL_FROM_NAME=BrightFuture
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
